ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304680/extras/5570faac040cb01984026304beb267fb.poster.avif?t=1773305310\" width=616 height=238 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304680/extras/5570faac040cb01984026304beb267fb.webm?t=1773305310\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1304680/extras/5570faac040cb01984026304beb267fb.mp4?t=1773305310\" type=\"video/mp4\"></video></span>","requirements_minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 (32-bit) or above<br></li><li><strong>Processor:</strong> i3-530 or equivalent<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GT 425M<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","requirements_recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> i7-4770 or equivalent<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 870M or equivalent<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>","genres":["Action","Adventure","Indie"],"developers":["semiwork"],"publishers":["semiwork"],"release_date":"8 Jun, 2023"}