team/apps/3355100/extras/703e74c6e556f998a7745b495882b4ab.poster.avif?t=1782390567\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/703e74c6e556f998a7745b495882b4ab.webm?t=1782390567\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/703e74c6e556f998a7745b495882b4ab.mp4?t=1782390567\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Explore richly illustrated environments filled with hidden paths, abandoned temples, frozen labs, and fungal forests await! </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/a4bd04ce682666852826585010f42b8b.poster.avif?t=1782390567\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/a4bd04ce682666852826585010f42b8b.webm?t=1782390567\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/a4bd04ce682666852826585010f42b8b.mp4?t=1782390567\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Unravel the mysterious story lurking beneath the surface!<br>Reveal secrets and access new areas with powerful gear!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/18b47abd788f63dc98ae401d3ba46605.poster.avif?t=1782390567\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/18b47abd788f63dc98ae401d3ba46605.webm?t=1782390567\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3355100/extras/18b47abd788f63dc98ae401d3ba46605.mp4?t=1782390567\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Enjoy an exclusive, atmospheric soundtrack!</p><p class=\"bb_paragraph\" >Have fun in the biggest Devcats game yet!</p><p class=\"bb_paragraph\" >Are you brave enough to uncover what happened on A Planet Full of Cats?</p>","requirements_minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 or superior<br></li><li><strong>Processor:</strong> Requires a 64-bit processor and operating system<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> 512 MB display memory<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> DirectSound-compatible sound card</li></ul>","requirements_recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>","genres":["Casual","Indie"],"developers":["Devcats"],"publishers":["Devcats"],"release_date":"Apr 9, 2026"}