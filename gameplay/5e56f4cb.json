0e99e2903ece7df0.webm?t=1593206301\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/76b063d1840129660e99e2903ece7df0.mp4?t=1593206301\" type=\"video/mp4\"></video></span><br><br>Collect items in the map or earn money and buy items in the shop. Each item allows you to complete a specific mission and enhances your progress in the game.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/a3aba0af89fa93418a5322b8a954b23b.poster.avif?t=1593206301\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/a3aba0af89fa93418a5322b8a954b23b.webm?t=1593206301\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/a3aba0af89fa93418a5322b8a954b23b.mp4?t=1593206301\" type=\"video/mp4\"></video></span><br><br>Explore the map and interact with the elements that surround you.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/19f543042e5d49cfe958be64b83b8744.poster.avif?t=1593206301\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/19f543042e5d49cfe958be64b83b8744.webm?t=1593206301\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1218280/extras/19f543042e5d49cfe958be64b83b8744.mp4?t=1593206301\" type=\"video/mp4\"></video></span>","requirements_minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS *:</strong> Windows 7<br></li><li><strong>Processor:</strong> Intel Core i5<br></li><li><strong>Memory:</s