f97a5db.poster.avif?t=1776580044\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/2c8a37337b8914ca63263a268f97a5db.webm?t=1776580044\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/2c8a37337b8914ca63263a268f97a5db.mp4?t=1776580044\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Write down the most varied requests for even more varied monsters.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/ccb381eb19a9c29af3002ac181edf382.avif?t=1776580044\" width=800 height=100 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/e94ec24c43da943cdafc865eee997655.poster.avif?t=1776580044\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/e94ec24c43da943cdafc865eee997655.webm?t=1776580044\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/e94ec24c43da943cdafc865eee997655.mp4?t=1776580044\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Grind up the humans and turn them into prime meat.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/2a2e9436def7bbff576e37b01a309b5a.avif?t=1776580044\" width=800 height=100 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9a499546bbdca98681cd1d7027bc1aeb.poster.avif?t=1776580044\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9a499546bbdca98681cd1d7027bc1aeb.webm?t=1776580044\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9a499546bbdca98681cd1d7027bc1aeb.mp4?t=1776580044\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Shape the meat into a variety of dishes.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/7f93e64517f1803362a46006827c0111.avif?t=1776580044\" width=800 height=100 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9e4baeaffeb7425c39f48418be7c2386.poster.avif?t=1776580044\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9e4baeaffeb7425c39f48418be7c2386.webm?t=1776580044\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/9e4baeaffeb7425c39f48418be7c2386.mp4?t=1776580044\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Prepare the food but be careful not to burn it!</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/09654a35c892990ff46678847c1c7a90.avif?t=1776580044\" width=800 height=100 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/00366071313010180e0dbaeda570ff55.poster.avif?t=1776580044\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/00366071313010180e0dbaeda570ff55.webm?t=1776580044\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3281090/extras/00366071313010180e0dbaeda570ff55.mp4?t=1776580044\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Serve customers and collect your profit.</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Additional Features:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Enjoy the relaxing Dark Fantasy style</p></li><li><p class=\"bb_paragraph\" >Manage your stock and buy new bags of food</p></li><li><p class=\"bb_paragraph\" >Customize your restaurant and make it just the way you want it</p></li><li><p class=\"bb_paragraph\" >Upgrade your appliances to make them faster, prettier and more efficient</p></li><li><p class=\"bb_paragraph\" >Hire monster cats to help you</p></li></ul>","requirements_minimum":"<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5 or AMD equivalent younger than 10 years<br></li><li><strong>Graphics:</strong> Any GPU with 3GB + Vram<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Any<br></li><li><strong>Additional Notes:</strong> If you're not sure your computer can run the game, try the demo in early December before purchasing</li></ul>","requirements_recommended":"<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5 10th generation or AMD equivalent<br></li><li><strong>Graphics:</strong> Dedicated GPU with 6GB Vram<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Any<br></li><li><strong>Additional Notes:</strong> This setting runs the game on Ultra</li></ul>","genres":["Simulation"],"developers":["Bricchi Games"],"publishers":["Bricchi Games"],"release_date":"24 Apr, 2025"}