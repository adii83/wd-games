static.com/store_item_assets/steam/apps/1150950/extras/9d9e3938a181cb7127fa7f7eb8cae30b.poster.avif?t=1669958187\" width=636 height=358 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/9d9e3938a181cb7127fa7f7eb8cae30b.webm?t=1669958187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/9d9e3938a181cb7127fa7f7eb8cae30b.mp4?t=1669958187\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/4df48ebafc72b5803b9fe4d1f47d0334.poster.avif?t=1669958187\" width=636 height=358 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/4df48ebafc72b5803b9fe4d1f47d0334.webm?t=1669958187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/4df48ebafc72b5803b9fe4d1f47d0334.mp4?t=1669958187\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/5002f985f7ca2b7068c77466b8f01d2e.poster.avif?t=1669958187\" width=636 height=358 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/5002f985f7ca2b7068c77466b8f01d2e.webm?t=1669958187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/5002f985f7ca2b7068c77466b8f01d2e.mp4?t=1669958187\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/31135c54687cd2de550b2cd2e0836865.avif?t=1669958187\" width=637 height=81 /></span><br><br>The Timeline ability gives players the power to control time just like a media player. Drag the Timeline left to rewind time and undo your past mistakes. Drag it right to watch your future unfold and gain you valuable information to change your past.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/efd3beb404b2962f1ce34d3b6fe76aea.poster.avif?t=1669958187\" width=552 height=308 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/efd3beb404b2962f1ce34d3b6fe76aea.webm?t=1669958187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/efd3beb404b2962f1ce34d3b6fe76aea.mp4?t=1669958187\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/9ab9a5e7a396a236b037a78a87d33520.avif?t=1669958187\" width=637 height=80 /></span><br><br>Control both the girl and the cat simultaneously, timing their movements and actions to complement each other, escape detection, distract enemies, and ultimately escape the world they’re trapped in. Experience cooperative play for a single player like never before.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/e4191c4745633547c80b737109240d59.poster.avif?t=1669958187\" width=552 height=308 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/e4191c4745633547c80b737109240d59.webm?t=1669958187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1150950/extras/e4191c4745633547c80b737109240d59.mp4?t=1669958187\" type=\"video/mp4\"></video></span><br><br><span c